# ================================================================
# ELSxGlobal + VaultHost — Environment Variables Template
# ================================================================
# Copy this to .env.local for local dev:
#   cp .env.example .env.local
#
# For production (Coolify): set these in Coolify's Environment
# Variables section — NEVER commit real secrets to git.
# ================================================================

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://supabase.elsxglobal.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (not public) — for migrations & admin
SUPABASE_URL=http://supabase.elsxglobal.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database (direct connection — for migrations fallback) ────────
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:your-password@db.supabase.elsxglobal.com:5432/postgres

# If using embedded PostgreSQL (docker compose --profile embedded-db)
POSTGRES_DB=elsxglobal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ── Application ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.elsxglobal.com
NODE_ENV=production

# ── Payments (Razorpay) ───────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Admin & Security ──────────────────────────────────────────────
ADMIN_SECRET=generate-32-char-random-string-here
ACTION_GATEWAY_SECRET=generate-another-32-char-random-string

# ── Migration Control ─────────────────────────────────────────────
SKIP_MIGRATIONS=false       # true = skip DB migrations on startup
MIGRATIONS_STRICT=false     # true = crash on migration failure (default: warn and continue)

# ── Backup Configuration ──────────────────────────────────────────
BACKUP_KEEP_DAYS=30         # days to keep local backups

# Optional: S3/R2 backup upload
# BACKUP_S3_BUCKET=your-bucket-name
# BACKUP_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# BACKUP_S3_KEY=your-s3-access-key
# BACKUP_S3_SECRET=your-s3-secret-key

# ── PgAdmin (optional, docker compose --profile admin) ────────────
# PGADMIN_EMAIL=admin@elsxglobal.com
# PGADMIN_PASSWORD=change-me-strong-password
