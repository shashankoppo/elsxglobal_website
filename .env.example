# Environment Variables — ELSxGlobal + VaultHost
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.

# ─── App ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NODE_ENV=development

# ─── Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Database (Postgres / Drizzle) ────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth ─────────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3001

# ─── Payments (Razorpay) ──────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── Email (optional) ─────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@elsxglobal.com
# SMTP_PASSWORD=your-smtp-password

# Razorpay Webhook (from Razorpay Dashboard > Webhooks > Secret)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email (Resend.com - for transactional emails via Supabase Edge Functions)
RESEND_API_KEY=re_xxxx

# App
NEXT_PUBLIC_SITE_URL=https://elsxglobal.com

# ═══ VaultHost Backend Services ═══════════════════════════════════
# PowerDNS
POWERDNS_URL=http://YOUR_DNS_SERVER:8081
POWERDNS_API_KEY=changeme

# MinIO Object Storage
MINIO_ENDPOINT=http://YOUR_STORAGE_SERVER:9000
MINIO_ACCESS_KEY=vaulthost
MINIO_SECRET_KEY=changeme

# LiteLLM AI Gateway
LITELLM_BASE_URL=http://YOUR_AI_SERVER:4000
LITELLM_MASTER_KEY=sk-changeme

# FRP Tunnel Server
FRP_SERVER_URL=http://YOUR_TUNNEL_SERVER:7400
FRP_SERVER_TOKEN=changeme
FRP_BASE_DOMAIN=tunnel.vaulthost.cloud

# RabbitMQ Queues
RABBITMQ_URL=amqp://vaulthost:changeme@YOUR_QUEUE_SERVER:5672
RABBITMQ_MANAGEMENT_URL=http://YOUR_QUEUE_SERVER:15672
RABBITMQ_USERNAME=vaulthost
RABBITMQ_PASSWORD=changeme

# Coolify Pages/CI-CD
COOLIFY_BASE_URL=http://YOUR_PAGES_SERVER:8000
COOLIFY_API_KEY=changeme

# Namecheap Domain Registrar
NAMECHEAP_API_USER=your_username
NAMECHEAP_API_KEY=your_api_key
NAMECHEAP_CLIENT_IP=your_server_ip
NAMECHEAP_SANDBOX=true

# workerd Edge Workers Runtime
WORKERD_API_URL=http://YOUR_WORKERS_SERVER:8787

# K3s Kubernetes
K3S_API_URL=https://YOUR_K3S_SERVER:6443
K3S_BEARER_TOKEN=your_k3s_token
