# ================================================================
# ELSxGlobal + Full Supabase Stack — Environment Variables
# ================================================================
# 1. Copy this: cp .env.supabase.example .env
# 2. Fill in EVERY value marked with <CHANGE THIS>
# 3. Run: docker compose -f docker-compose.supabase.yml up -d
# ================================================================

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=<CHANGE THIS — strong password>

# ── JWT (generate these with: openssl rand -base64 32) ──────────
JWT_SECRET=<CHANGE THIS — 32+ char random string>
JWT_EXPIRY=3600
SECRET_KEY_BASE=<CHANGE THIS — openssl rand -base64 64>

# ── Supabase API Keys ────────────────────────────────────────────
# Generate at: https://supabase.com/docs/guides/self-hosting#api-keys
# Or use the JWT tool: https://jwt.io
# Payload for ANON_KEY:    {"role":"anon","iss":"supabase","iat":1794651960,"exp":4950325560}
# Payload for SERVICE_KEY: {"role":"service_role","iss":"supabase","iat":1794651960,"exp":4950325560}
ANON_KEY=<CHANGE THIS — generate JWT with role:anon>
SERVICE_ROLE_KEY=<CHANGE THIS — generate JWT with role:service_role>

# ── URLs ─────────────────────────────────────────────────────────
# This is what the app and browser use to reach Supabase
SUPABASE_PUBLIC_URL=http://supabase.elsxglobal.com
# Or if running locally: http://YOUR_SERVER_IP:8000
API_EXTERNAL_URL=http://supabase.elsxglobal.com
SITE_URL=https://www.elsxglobal.com

# ── Studio Dashboard ─────────────────────────────────────────────
STUDIO_PORT=54323
STUDIO_DEFAULT_ORGANIZATION=ELSxGlobal
STUDIO_DEFAULT_PROJECT=VaultHost
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=<CHANGE THIS — strong password>

# ── Realtime ─────────────────────────────────────────────────────
REALTIME_DB_ENC_KEY=supabaserealtime

# ── Storage ──────────────────────────────────────────────────────
GLOBAL_S3_BUCKET=storage
STORAGE_TENANT_ID=storage
REGION=local

# ── Meta ─────────────────────────────────────────────────────────
PG_META_CRYPTO_KEY=<CHANGE THIS — openssl rand -base64 32>

# ── PostgREST ────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ── App Settings ─────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
ADMIN_SECRET=<CHANGE THIS — openssl rand -hex 32>
ACTION_GATEWAY_SECRET=<CHANGE THIS — openssl rand -hex 32>

# ── SMTP (for auth emails) ───────────────────────────────────────
SMTP_ADMIN_EMAIL=admin@elsxglobal.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_SENDER_NAME=ELSxGlobal

# ── Migration Control ────────────────────────────────────────────
SKIP_MIGRATIONS=false
MIGRATIONS_STRICT=false
BACKUP_KEEP_DAYS=30

# ── Signup Settings ──────────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# ── Connection Limits ────────────────────────────────────────────
KONG_HTTP_PORT=8000
POOLER_TENANT_ID=elsxglobal
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6543
