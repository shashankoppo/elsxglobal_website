# =================================================================
# ELSxGlobal Docker Build Context Exclusions
# Keep the build context lean — only ship what the app needs
# =================================================================

# Version control
.git
.gitignore
.gitattributes
.github

# Documentation & ops (not in Docker image)
docs/
CHANGELOG.md
OPERATIONS.md
Makefile
README.md
*.md

# Environment files — secrets NEVER go in image
.env
.env.local
.env.production
.env.development
!.env.example

# Local development
node_modules
.next/cache

# Supabase local dev artifacts
supabase/.temp
supabase/.branches
supabase-docker/
supabase-production/

# Docker compose extras (not needed in app image)
docker-compose.dev.yml
docker-compose.monitoring.yml
docker-compose.supabase.yml
docker-compose.kong.yml

# Scripts NOT needed inside the app container
# (entrypoint.sh and migrate.mjs ARE needed)
scripts/*.sh
!scripts/entrypoint.sh
scripts/health-monitor.sh
scripts/backup.sh
scripts/restore.sh
scripts/setup-wizard.sh
scripts/cron-setup.sh

# Tests & lint
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.*
vitest.config.*
.eslintcache
coverage/

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini
._*

# IDE
.vscode
.idea
*.swp
*.swo
*.suo
.vs/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
scratch/
.cache/
